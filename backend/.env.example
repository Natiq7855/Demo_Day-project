# Copy to backend/.env — only GEMINI_API_KEY is required for AI features

# Dev (SQLite, no Postgres required):
DATABASE_URL=sqlite:///./curricula_dev.db

# Production example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/curricula_ai

GEMINI_API_KEY=your_gemini_api_key

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MEDIA_ROOT=storage
TEACHER_EMAIL=teacher@curricula.ai
TEACHER_PASSWORD=Teacher@12345
FRONTEND_ORIGIN=http://127.0.0.1:8000
